{
  "name": "worldhair-server",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "lint": "eslint --no-error-on-unmatched-pattern \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:e2e": "node -e \"if(!require('fs').existsSync('test/jest-e2e.json')){console.error('No database variant selected — run bun run setup:mongodb or bun run setup:supabase first.');process.exit(1)}\" && jest --config ./test/jest-e2e.json --runInBand",
    "typecheck": "tsc --noEmit",
    "setup:mongodb": "bun scripts/setup-mongodb.ts",
    "setup:supabase": "bun scripts/setup-supabase.ts",
    "seed:demo": "bun scripts/seed-demo-accounts.ts",
    "seed:catalogue": "bun scripts/seed-catalogue-salons.ts",
    "seed:admin": "bun scripts/seed-admin-account.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/event-emitter": "^2",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/schedule": "^4",
    "@nestjs/throttler": "^6.5.0",
    "@supabase/supabase-js": "^2.112.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "expo-server-sdk": "^3",
    "helmet": "^8.3.0",
    "nodemailer": "^9.0.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^6.4.24",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
