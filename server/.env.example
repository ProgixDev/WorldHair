# --- App ---
NODE_ENV=development
PORT=3000
# Comma-separated origins. Leave empty in local dev to allow any origin
# (fine for a mobile client too — it never sends an Origin header).
CORS_ORIGIN=

# No database variant is selected yet. Run `bun run setup:mongodb` or
# `bun run setup:supabase` first — each one replaces everything between the
# database:start/database:end markers below with its own vars. See
# server/README.md. Don't hand-edit variable NAMES in there; values are
# yours to fill in as usual.
# --- database:start ---
# --- Supabase ---
# From your Supabase project's Settings -> API page.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Privileged, Row-Level-Security-bypassing key — server-only. NEVER send this
# to a mobile/web client; the client uses SUPABASE_ANON_KEY with its own
# Supabase client instead. See src/database/supabase.service.ts.
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth ---
# No JWT secrets here: Supabase issues and verifies its own session tokens.
# The mobile/web client authenticates directly against Supabase
# (auth.signUp/signInWithPassword/refreshSession/signOut/etc. via
# @supabase/supabase-js) and sends the resulting access token to this API as
# `Authorization: Bearer <token>`. See src/auth/auth.module.ts and
# server/README.md. Supabase no longer sends its own auth emails at all: the
# "Send Email" Auth Hook (see SEND_EMAIL_HOOK_SECRET below) redirects every
# one of them here instead, so this server's mail/ module is what actually
# sends the signup code, the coiffeur validation/rejection email, and
# anything else — all through Resend, all in one place.
# --- database:end ---

# --- Rate limiting ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# --- Mail ---
# json (default): logs the rendered email instead of sending it — no
#   credentials needed, good for local dev and tests.
# resend: POSTs to Resend's HTTPS API. THIS IS THE ONLY TRANSPORT USED IN
#   PRODUCTION — this server runs on Render, which blocks outbound SMTP ports
#   (25/465/587) even on paid tiers, so HTTPS is the only way mail leaves at
#   all. (smtp/relay transports still exist in the code for a host that isn't
#   Render, but nothing here is configured to use them — don't reach for them
#   without a reason.)
MAIL_TRANSPORT=json
# The sender. With Resend this address MUST be on a domain verified in the
# Resend dashboard, otherwise every send is rejected with 422. Use
# `onboarding@resend.dev` to try it out before a domain is verified — that one
# can only deliver to the account owner's own address.
MAIL_FROM="App <no-reply@example.com>"
# Required only when MAIL_TRANSPORT=resend. From https://resend.com/api-keys.
RESEND_API_KEY=
# Signs Supabase's "Send Email" Auth Hook (Dashboard -> Authentication ->
# Auth Hooks -> Send Email -> Generate Secret). Once that hook is enabled,
# Supabase stops sending its own auth emails (verification code, email-change
# confirmation, ...) and POSTs them here instead, so they go out through
# Resend too — see src/auth/email-hook.service.ts. Format v1,whsec_<base64>;
# `|`-separate two secrets while rotating (new first) so an in-flight
# rotation never rejects a request signed with the old one.
SEND_EMAIL_HOOK_SECRET=
# How long the signup verification code is valid for, shown in the emailed
# copy's wording (src/mail/mail.templates.ts's verificationMail). Read
# whenever EmailHookService handles a "signup" action — i.e. whenever
# SEND_EMAIL_HOOK_SECRET's hook is actually enabled.
VERIFY_TOKEN_TTL_HOURS=24
RESET_TOKEN_TTL_MINUTES=60

# --- Push notifications (src/notifications/) ---
# Optional — only needed if this Expo project has enhanced push security
# enabled (https://docs.expo.dev/push-notifications/sending-notifications/#security).
# Push works fine against Expo's API without it for most projects.
EXPO_ACCESS_TOKEN=
