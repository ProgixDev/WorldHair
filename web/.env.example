# Base URL of the server API — used by any client-side code that talks to it.
NEXT_PUBLIC_API_URL=http://localhost:3000

# This site's own public URL — used to resolve og:image/twitter:image into
# absolute URLs (see src/app/layout.tsx's metadataBase). Set once deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Mail relay ---
# Receives POSTs from the server's mail service when MAIL_TRANSPORT=relay
# (see server/.env.example) — for a host whose own outbound SMTP is
# unreliable. Same shared secret must be set on both sides.
MAIL_RELAY_SECRET=
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="App <no-reply@example.com>"
