{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Logo.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.mobile",
      "infoPlist": {
        "UIStatusBarHidden": true,
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "androidNavigationBar": {
      "backgroundColor": "#00000000"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/Logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY"
        }
      },
      "package": "com.anonymous.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Logo.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f9fc",
          "image": "./assets/images/Logo.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#080f1a",
            "image": "./assets/images/Logo.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "WorldHair accède à vos photos pour votre photo de profil et vos justificatifs.",
          "cameraPermission": "WorldHair utilise l'appareil photo pour photographier vos justificatifs."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WorldHair utilise votre position pour afficher les coiffeurs à proximité.",
          "locationAlwaysAndWhenInUsePermission": "WorldHair utilise votre position pour afficher les coiffeurs à proximité.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "./plugins/withTransparentNavigationBar",
      "./plugins/withTransparentStatusBar"
    ]
  }
}
