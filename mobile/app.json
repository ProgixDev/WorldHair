{
  "expo": {
    "name": "worldhair",
    "slug": "worldhair",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "worldhair",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.progix.worldhair",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIStatusBarHidden": true,
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "androidNavigationBar": {
      "backgroundColor": "#00000000"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080f1a",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY"
        }
      },
      "package": "com.progix.worldhair",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Logo.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f9fc",
          "image": "./assets/images/Logo.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#080f1a",
            "image": "./assets/images/Logo.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "WorldHair accède à vos photos pour votre photo de profil et vos justificatifs.",
          "cameraPermission": "WorldHair utilise l'appareil photo pour photographier vos justificatifs.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WorldHair utilise votre position pour afficher les coiffeurs à proximité.",
          "locationAlwaysAndWhenInUsePermission": "WorldHair utilise votre position pour afficher les coiffeurs à proximité.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-video",
      "./plugins/withTransparentNavigationBar",
      "./plugins/withTransparentStatusBar",
      "./plugins/withReleaseSigning",
      "./plugins/withDebugSigning"
    ],
    "extra": {
      "googleMapsConfigured": false,
      "router": {
        "root": "./src/app"
      },
      "eas": {
        "projectId": "7b0a922e-79f8-4c53-9fb2-4ee08198eb75"
      }
    },
    "owner": "andreworldhair"
  }
}
