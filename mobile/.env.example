# Mapbox public token (pk.*), inlined in the app at build time.
EXPO_PUBLIC_MAPBOX_PK=

# Mapbox download token (sk.*, scope DOWNLOADS:READ), build-time only.
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=

# Local release signing — see plugins/withReleaseSigning.js.
# Filled in automatically by `bun scripts/setup-android-keystores.ts`.
# Absent entirely, release builds fall back to debug signing (same as stock).
RELEASE_STORE_FILE=
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=
