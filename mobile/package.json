    "@tanstack/react-query": "^5.101.4",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
