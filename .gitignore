# generated native folders
/mobile/ios
/mobile/android
/web/.next

# release signing key — outside android/ so `expo prebuild --clean` can never
# touch it; ignored wholesale (not just *.jks) so nothing dropped in here
# later (a .properties file, notes) leaks by accident
/mobile/keystores

# ...except the debug keystore: standard androiddebugkey/android creds, not a
# secret. Committed on purpose so its SHA-1 (registered with Google OAuth as
# the debug client) stays stable across clones and `prebuild --clean`, instead
# of AGP silently minting a new random key every time android/ is wiped.
!/mobile/keystores/debug.keystore

# VS Code
.vscode/

# mongodb-memory-server binaries
server/.cache/

# git worktrees (superpowers:using-git-worktrees)
.worktrees/
worktrees/
